{
  "name": "qadam-growth-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/domain/__tests__/*.test.ts",
    "test:domain": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/domain/__tests__/*.test.ts",
    "db:start": "supabase start",
    "db:reset:local": "supabase db reset --local",
    "db:test": "supabase db reset --local && supabase test db --local supabase/tests/database",
    "db:types": "supabase gen types --local --schema public",
    "check:secrets": "node scripts/check-client-secrets.mjs",
    "check:data-layer": "node scripts/check-data-layer.mjs",
    "check:markup": "node scripts/check-nested-forms.mjs",
    "test:e2e": "node tests/e2e/run-all.mjs",
    "test:security": "node tests/security/run-all.mjs",
    "test:a11y": "node tests/a11y/audit.mjs",
    "db:test:nocopy": "supabase test db --local supabase/tests/database",
    "test:perf": "node tests/perf/measure.mjs",
    "check:types-drift": "node scripts/check-type-drift.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run check:markup && npm run check:secrets && npm run check:data-layer && npm run check:types-drift && npm run build",
    "test:release": "node tests/release/run-all.mjs",
    "test:modes": "node tests/release/mode-separation.mjs",
    "seed:remote": "node scripts/make-remote-demo-seed.mjs",
    "demo:restore": "node scripts/restore-demo.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:stop": "supabase stop"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "@types/qrcode": "1.5.5",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "gsap": "^3.15.0",
    "lenis": "^1.1.18",
    "lucide-react": "^0.469.0",
    "motion": "^11.15.0",
    "next": "^16.2.12",
    "qrcode": "1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.12.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.2.12",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "supabase": "2.110.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "^0.35.0"
  }
}
