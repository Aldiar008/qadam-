# Browser-safe Supabase values. Use the modern publishable key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Server-only. Never add NEXT_PUBLIC_ to this name or import the admin client from Client Components.
SUPABASE_SECRET_KEY=replace-with-local-secret-key

# DEMO_MODE permits only synthetic data. PRODUCTION_MODE refuses demo fixtures/connectors.
QADAM_APP_MODE=DEMO_MODE
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI generation (all server-only; never prefix with NEXT_PUBLIC_) ---------
# Leave QADAM_AI_PROVIDER unset or 'none' to run on the built-in deterministic
# template. That is a supported state: the app labels the output as templated
# rather than pretending a model wrote it.
QADAM_AI_PROVIDER=none
# QADAM_AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=replace-with-server-only-key
# QADAM_AI_PROVIDER=openai
# OPENAI_API_KEY=replace-with-server-only-key
# QADAM_AI_PROVIDER=gemini
# GEMINI_API_KEY=replace-with-server-only-key
# QADAM_AI_MODEL=gemini-3.6-flash
# QADAM_AI_BASE_URL=https://api.anthropic.com
QADAM_AI_TIMEOUT_MS=20000
QADAM_AI_MAX_ATTEMPTS=3
QADAM_AI_COST_CEILING_MICROS=250000
QADAM_AI_DAILY_GENERATIONS=40
QADAM_AI_DAILY_COST_MICROS=2000000

# Set to 'connected' only when a real identity verification provider is wired.
# QADAM_IDENTITY_PROVIDER=connected

# --- Execution: scheduler and connectors (server-only) ----------------------
# No production cron/queue is configured. An external caller (local runner or a
# platform scheduler) drives the loop by POSTing to /api/jobs/run-cycle with
# this secret. Without it the endpoint answers 503 rather than running unguarded.
QADAM_JOB_SECRET=replace-with-a-long-random-value
# Shared secret for signing outbound webhook calls and verifying inbound
# provider events. Per-channel override: QADAM_WEBHOOK_SECRET_WHATSAPP, etc.
QADAM_WEBHOOK_SECRET=replace-with-a-long-random-value
QADAM_CONNECTOR_TIMEOUT_MS=10000

# Vendor adapters are declared boundaries, not implementations. Supplying these
# does not make a channel live: a passing health check is still required before
# the database will store connector_state='connected'.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# TELEGRAM_BOT_TOKEN=
# INSTAGRAM_PAGE_ID=
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_APP_SECRET=
